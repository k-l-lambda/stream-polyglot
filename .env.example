# Stream-Polyglot Environment Configuration

# m4t API Server URL (SeamlessM4T translation backend)
# Default: http://localhost:8000
# M4T_API_URL=http://localhost:8000

# LLM API configuration (for lecture_annotator annotation)
# Any OpenAI-compatible API endpoint works (OpenAI, Azure, local LLM, etc.)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...
